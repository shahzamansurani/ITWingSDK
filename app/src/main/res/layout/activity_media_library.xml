<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <include
            android:id="@+id/toolbar"
            layout="@layout/custom_toolbar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Ringtone Top Trends"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.itwingtech.itwingsdk.media.ITWingTopTrendsRingtoneView
            android:id="@+id/ringtoneTrends"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            app:ITWingMediaColumns="1"
            app:ITWingMediaHorizontal="true"
            app:ITWingMediaPlacement="top_trends" />

        <com.itwingtech.itwingsdk.media.ITWingRingtoneCategoriesView
            android:id="@+id/ringtoneCategories"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            app:ITWingMediaCategoryDisplayMode="both"
            app:ITWingMediaCategoryHorizontal="true"
            app:ITWingMediaLinkedView="@id/ringtones"
            app:ITWingMediaPlacement="categories" />

        <com.itwingtech.itwingsdk.media.ITWingRingtonesView
            android:id="@+id/ringtones"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="8dp"
            app:ITWingMediaColumns="2"
            app:ITWingMediaPlacement="ringtones"
            app:ITWingMediaPremiumUnlockPlacement="rewarded" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Video Top Trends"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.itwingtech.itwingsdk.media.ITWingTopTrendsVideoView
            android:id="@+id/videoTrends"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="8dp"
            app:ITWingMediaHorizontal="true"
            app:ITWingMediaPlacement="top_trends" />

        <com.itwingtech.itwingsdk.media.ITWingVideoCategoriesView
            android:id="@+id/videoCategories"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            app:ITWingMediaCategoryDisplayMode="both"
            app:ITWingMediaCategoryHorizontal="true"
            app:ITWingMediaLinkedView="@id/videos"
            app:ITWingMediaPlacement="categories" />

        <com.itwingtech.itwingsdk.media.ITWingVideosView
            android:id="@+id/videos"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="8dp"
            app:ITWingMediaColumns="2"
            app:ITWingMediaPlacement="videos"
            app:ITWingMediaPremiumUnlockPlacement="rewarded" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
