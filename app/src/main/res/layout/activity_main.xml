<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.itwingtech.itwingsdk.ads.ITWingAdView
        android:id="@+id/topBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ITWingAdViewPlacement="@string/home_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBanner">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="ITWing SDK Example" />

            <TextView
                android:id="@+id/diagnosticsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#424242"
                android:textSize="13sp"
                tools:text="Diagnostics" />

            <TextView
                android:id="@+id/apiText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#424242"
                android:textSize="13sp"
                tools:text="API helpers" />

            <TextView
                android:id="@+id/firebaseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#424242"
                android:textSize="13sp"
                tools:text="Firebase status" />

            <TextView
                android:id="@+id/notificationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#424242"
                android:textSize="13sp"
                tools:text="Notification and billing status" />

            <com.itwingtech.itwingsdk.billing.ITWingPremiumView
                style="@style/ITWingPremiumCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/refreshConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Refresh Remote Config" />
            <Button android:id="@+id/trackEvent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Track Analytics Event" />
            <Button android:id="@+id/preloadAds" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preload Fullscreen Ads" />
            <Button android:id="@+id/showPurchaseDialog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Purchase Dialog" />
            <Button android:id="@+id/restorePurchases" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore Purchases" />
            <Button android:id="@+id/checkForUpdates" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Check For In-app Updates" />
            <Button android:id="@+id/directSubscription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Launch Subscription: premium_monthly" />
            <Button android:id="@+id/openWallpaperDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Wallpaper Views Demo" />
            <Button android:id="@+id/openMediaDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Ringtone / Video Views Demo" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Inline Ads — ITWingAdView" android:textColor="@android:color/black" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="The placement name is the only host-side choice; current SDK config selects Banner or Native." android:textColor="#424242" android:textSize="13sp" />
            <com.itwingtech.itwingsdk.ads.ITWingAdView android:id="@+id/nativeSmallDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:ITWingAdViewPlacement="@string/native_small_demo" />
            <com.itwingtech.itwingsdk.ads.ITWingAdView android:id="@+id/nativeLargeDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:ITWingAdViewPlacement="@string/native_large_demo" />
            <com.itwingtech.itwingsdk.ads.ITWingAdView android:id="@+id/normalBannerDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:ITWingAdViewPlacement="@string/normal_banner_demo" />
            <com.itwingtech.itwingsdk.ads.ITWingAdView android:id="@+id/customBannerDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:ITWingAdViewPlacement="@string/custom_banner_demo" />
            <com.itwingtech.itwingsdk.ads.ITWingAdView android:id="@+id/customNativeSmallDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:ITWingAdViewPlacement="@string/custom_native_small_demo" />
            <com.itwingtech.itwingsdk.ads.ITWingAdView android:id="@+id/customNativeLargeDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:ITWingAdViewPlacement="@string/custom_native_large_demo" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Screen-edge collapsible demos" android:textColor="@android:color/black" android:textSize="18sp" android:textStyle="bold" />
            <Button android:id="@+id/openTopCollapsibleDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Top-edge Collapsible Demo" />
            <Button android:id="@+id/openBottomCollapsibleDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open Bottom-edge Collapsible Demo" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Fullscreen ads" android:textColor="@android:color/black" android:textSize="18sp" android:textStyle="bold" />
            <Button android:id="@+id/realInterstitial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Interstitial" />
            <Button android:id="@+id/splashInterstitial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Splash Interstitial" />
            <Button android:id="@+id/customInterstitial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Custom Interstitial" />
            <Button android:id="@+id/nativeRecovery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Interstitial → Native Recovery" />
            <Button android:id="@+id/bannerRecovery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Interstitial → Banner Recovery" />
            <Button android:id="@+id/showExitDialog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/example_show_exit_dialog" />
            <Button android:id="@+id/showFeedbackDialog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/example_show_feedback_dialog" />
            <Button android:id="@+id/showLoadingDialog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/example_show_loading_dialog" />
            <Button android:id="@+id/resetExitRatingState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/example_reset_exit_rating_state" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Rewarded ads" android:textColor="@android:color/black" android:textSize="18sp" android:textStyle="bold" />
            <Button android:id="@+id/rewardedVideo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Rewarded Video" />
            <Button android:id="@+id/rewardedImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Rewarded Again" />
            <Button android:id="@+id/customRewarded" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Custom Rewarded" />
            <Button android:id="@+id/realRewardedInterstitial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Rewarded Interstitial" />
            <Button android:id="@+id/customRewardedInterstitial" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Custom Rewarded With Callback Navigation" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="App Open" android:textColor="@android:color/black" android:textSize="18sp" android:textStyle="bold" />
            <Button android:id="@+id/appOpenResume" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show App Open: app_open_auto" />
            <Button android:id="@+id/appOpenSplash" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show App Open Again" />
            <Button android:id="@+id/appOpenButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show App Open By Button" />
            <Button android:id="@+id/customAppOpen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show App Open From Host" />
            <Button android:id="@+id/syncNotification" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Sync Fallback Notification Token" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
