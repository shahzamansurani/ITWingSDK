<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="@style/ITWingAdCardTheme"
    app:cardBackgroundColor="@color/itwing_sdk_surface"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardElevation="5dp"
    app:cardPreventCornerOverlap="false"
    app:useCompatPadding="true"
    app:strokeColor="@color/itwing_sdk_stroke"
    app:strokeWidth="1dp">

    <ScrollView
        android:id="@+id/itwing_purchase_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fillViewport="false">

    <LinearLayout
        android:id="@+id/itwing_purchase_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/itwing_purchase_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:background="@drawable/itwing_purchase_card_bg"
            android:contentDescription="@android:string/cancel"
            android:padding="9dp"
            android:src="@drawable/itwing_ic_close"
            app:tint="@color/itwing_sdk_text_primary" />

        <TextView
            android:id="@+id/itwing_purchase_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/itwing_purchase_card_bg"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Premium"
            android:textAllCaps="false"
            android:textColor="@color/itwing_sdk_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itwing_purchase_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Upgrade your app"
            android:textColor="@color/itwing_sdk_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itwing_purchase_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="16dp"
            android:text="Plans and prices are loaded from Google Play and controlled from ITWing admin."
            android:textColor="@color/itwing_sdk_text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/itwing_purchase_products"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/itwing_purchase_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/itwing_purchase_card_bg"
            android:padding="12dp"
            android:textColor="@color/itwing_sdk_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/itwing_purchase_restore"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:text="Restore purchases"
            android:textSize="@dimen/_10ssp"
            android:textAllCaps="false"
            android:textColor="#F8FAFC"
            app:cornerRadius="@dimen/itwing_primary_cta_corner_radius"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/itwing_purchase_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="Not now"
            android:textAllCaps="false"
            android:textColor="#CBD5E1"
            android:visibility="gone"
            app:cornerRadius="@dimen/itwing_primary_cta_corner_radius" />

    </LinearLayout>
</ScrollView>
</com.google.android.material.card.MaterialCardView>
