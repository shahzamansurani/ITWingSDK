<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itwing_in_app_notification_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/itwing_purchase_dialog_bg"
    android:fillViewport="false">

    <LinearLayout
        android:id="@+id/itwing_in_app_notification_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/itwing_in_app_notification_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:background="@drawable/itwing_purchase_card_bg"
            android:contentDescription="@android:string/cancel"
            android:padding="9dp"
            android:tint="#F8FAFC"
            android:src="@drawable/itwing_ic_close" />

        <FrameLayout
            android:id="@+id/itwing_in_app_notification_media_frame"
            android:layout_width="match_parent"
            android:layout_height="164dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/itwing_purchase_card_bg"
            android:clipToOutline="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/itwing_in_app_notification_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/itwing_in_app_notification_image"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <TextView
            android:id="@+id/itwing_in_app_notification_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/itwing_purchase_card_bg"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/itwing_in_app_notification_badge"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itwing_in_app_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textColor="#F8FAFC"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itwing_in_app_notification_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/itwing_in_app_notification_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
